# Copie para .env.local e preencha com as chaves do seu projeto Supabase.
# A chave publicável é pública por natureza — ela roda no navegador e é o RLS
# que protege os dados. Nunca coloque aqui a chave secreta (service_role).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_KEY=sb_publishable_XXXXXXXXXXXXXXXX
